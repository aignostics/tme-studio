{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>aignostics/renovate-config"],
  "labels": ["bot", "renovate", "dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "requires-python is a support range that we widen by hand, not a version to bump",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Widen Python dependency ranges to maximise library compatibility",
      "matchManagers": ["pep621"],
      "rangeStrategy": "widen"
    },
    {
      "groupName": "minor and patch dependencies",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "separateMajorMinor": false
    },
    {
      "groupName": "pre-commit hooks",
      "matchManagers": ["pre-commit"],
      "separateMajorMinor": false
    },
    {
      "groupName": "mise tools",
      "matchManagers": ["mise"],
      "separateMajorMinor": false
    }
  ]
}
